<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="commitbrief-ui"
        Arguments=""
        InstallLocation="C:\Program Files\CommitBrief\CommitBrief UI">
    </Installer>
    <PackageInformation
        PackageName="CommitBrief UI"
        PackageDisplayName="CommitBrief UI"
        PublisherName="CN=CommitBrief"
        PublisherDisplayName="CommitBrief"
        Version="0.1.0.0"
        PackageDescription="Desktop companion for the CommitBrief CLI">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.commitbrief.ui"
                Description="Desktop companion for the CommitBrief CLI"
                DisplayName="CommitBrief UI"
                ExecutableName="commitbrief-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>CommitBrief UI</DisplayName>
            <PublisherDisplayName>CommitBrief</PublisherDisplayName>
            <Description>Desktop companion for the CommitBrief CLI</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="commitbrief-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
